    // YAFC state. The popup publishes the live selection to a RAM mailbox;
    // only the Settings page persists preferences.
    property bool yafcPanelOpen: false
    property bool yafcHideChromePref: true
    readonly property bool yafcHideChrome: yafcHideChromePref
    // The mod is active whenever the config asks the native to compose. The
    // custom controls and backdrop follow this, not yafcHideChrome: with the
    // bars shown (hide_chrome=0) the custom view still needs its selector.
    property bool yafcActive: false
    property string yafcView: "rear"
    // Which view button is lit. Not always the config value: several buttons
    // share a composed layout and differ only in the Ford stream or its zoom
    // level, so the config no longer identifies the selected button.
    property string yafcViewKey: "rear360"
    property bool yafcSensors: true
    property bool yafcZoom: false
    // Screen is 800x1280. Per view: `holes` are the rectangles where live
    // video shows through the transparent popup; `sen` is the sensor panel and
    // `senScale` its car size; `fill` is the black backdrop that covers
    // everything else, so no other app can show through a gap.
    readonly property var yafcViews: ({
        "rear360": { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "0,84,439,316", camDst: "0,0,800,518",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     holes: [[0,0,800,518],[0,522,456,718]],
                     sen: [456,522,344,718], senScale: 1.8,
                     fill: [[0,518,800,4],[0,1240,800,40]],
                     sensors: true,  zoom: false },
        // Trailer: Ford's zoom level applied to the plain rear stream, laid out
        // like Rear Only. Ford stays on IPMBRearNormal; selecting Ford's own
        // IPMBRearZoom stream gives the skewed Hero picture.
        "zoom":    { ford: AL2HMIBridge.RVCSource.IPMBRearNormal, cfg: "rear",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: true },
        "rear":    { ford: AL2HMIBridge.RVCSource.IPMBRearNormal, cfg: "rear",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "full360": { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "447,0,273,480", camDst: "0,0,800,1240",
                     baySrc: "447,0,273,480", bayDst: "0,0,0,0",
                     holes: [[0,0,800,1240]],
                     sen: [0,0,0,0], senScale: 1,
                     fill: [[0,1240,800,40]],
                     sensors: false, zoom: false },
        "wide":    { ford: AL2HMIBridge.RVCSource.IPMBRearSplit, cfg: "rear",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "front":   { ford: AL2HMIBridge.RVCSource.IPMBFrontNormal, cfg: "front",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "frontwide": { ford: AL2HMIBridge.RVCSource.IPMBFrontSplit, cfg: "front",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "front360only": { ford: AL2HMIBridge.RVCSource.IPMBFront360, cfg: "front360",
                     camSrc: "447,0,273,480", camDst: "0,0,800,1240",
                     baySrc: "447,0,273,480", bayDst: "0,0,0,0",
                     holes: [[0,0,800,1240]],
                     sen: [0,0,0,0], senScale: 1,
                     fill: [[0,1240,800,40]],
                     sensors: false, zoom: false },
        "front360": { ford: AL2HMIBridge.RVCSource.IPMBFront360, cfg: "front360",
                     camSrc: "0,84,439,316", camDst: "0,0,800,518",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     holes: [[0,0,800,518],[0,522,456,718]],
                     sen: [456,522,344,718], senScale: 1.8,
                     fill: [[0,518,800,4],[0,1240,800,40]],
                     sensors: true,  zoom: false }
    })

    // The look of the current view; set by yafcLook(). Defaults are the Hero.
    property var yafcSen: [456,522,344,718]
    property real yafcSenScale: 1.8
    property var yafcFill: [[0,518,800,4],[0,1240,800,40]]
    function yafcLook(e) {
        if (e === undefined || e.sen === undefined) return;
        yafcSen = e.sen;
        yafcSenScale = e.senScale;
        yafcFill = e.fill;
    }

    // Per-camera default view, chosen on the Camera Settings page. Stored in
    // camera.conf (`rear_view`, `front_view`) and applied whenever the popup
    // opens or closes.
    property string yafcFrontViewPref: "front360"
    property string yafcRearViewPref: "rear360"
    property string yafcConfigPath: "file:///fs/rwdata/yafc/camera.conf"
    property string yafcDisablePath: "file:///fs/rwdata/yafc/DISABLE"

    function yafcDisabled() {
        var xhr = new XMLHttpRequest();
        try {
            xhr.open("GET", yafcDisablePath, false);
            xhr.send();
            // A local reply can have status 0 even on success. The length
            // header also detects an empty marker made with touch.
            return xhr.status === 200 ||
                    (xhr.status === 0 && (/^[0-9]+$/.test(xhr.getResponseHeader("Content-Length")) ||
                                         xhr.responseText.length > 0));
        } catch (e) {
            return true;
        }
    }

    function yafcLoadConfig() {
        yafcHideChromePref = true;
        yafcFrontViewPref = "front360";
        yafcRearViewPref = "rear360";
        yafcCoverMs = 700;
        if (yafcDisabled()) { yafcHideChromePref = false; yafcActive = false; return false; }
        var mode = "pass";
        var enabled = true;
        var sawEnabled = false;
        var xhr = new XMLHttpRequest();
        try {
            xhr.open("GET", yafcConfigPath, false);
            xhr.send();
            if (xhr.status === 0 || xhr.status === 200) {
                var lines = xhr.responseText.split("\n");
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i].trim();
                    if (line.length === 0 || line.charAt(0) === "#") continue;
                    var eq = line.indexOf("=");
                    if (eq < 0) continue;
                    var key = line.substring(0, eq).trim();
                    var val = line.substring(eq + 1).trim();
                    if (key === "front_view") yafcFrontViewPref = val;
                    if (key === "rear_view") yafcRearViewPref = val;
                    if (key === "mode") mode = val;
                    if (line.indexOf("enabled=") === 0 && !sawEnabled) {
                        enabled = line.charAt(8) !== "0";
                        sawEnabled = true;
                    }
                    if (key === "hide_chrome") yafcHideChromePref = (val === "1");
                    if (key === "cover_ms") yafcCoverMs = Math.max(0, Math.min(3000, parseInt(val, 10) || 0));
                }
            }
        } catch (e) {
            console.log("yafc: config read failed: " + e);
        }
        // Only hide the chrome when the config asks the library to compose. With
        // the mod off, Ford keeps its own layout and its own chrome.
        yafcActive = enabled && mode === "compose";
        if (!yafcActive) yafcHideChromePref = false;
        return yafcActive;
    }

    // Session identity: PID.monotonic_sec.monotonic_nsec;
    // The native writes /fs/tmpfs/yafc-session at start. The popup reads it
    // on entry and prefixes every mailbox record with it. A mismatch means the
    // native restarted or is absent; the popup then stops asserting a custom
    // layout. There is no atomic cross-process liveness proof: a ready reply
    // means the native processed the request and the compositor accepted the
    // property sets, not that the display painted the result. QML timers stall
    // with the render thread; a late-created bay may never paint.
    property string yafcSession: ""
    property string yafcRequestedKey: ""
    property int yafcSeq: 0
    property string yafcViewUrl: "file:///fs/tmpfs/yafc-view"
    property string yafcReadyUrl: "file:///fs/tmpfs/yafc-ready"
    property string yafcSessionUrl: "file:///fs/tmpfs/yafc-session"

    function yafcRead(url) {
        try {
            var xhr = new XMLHttpRequest();
            xhr.open("GET", url, false);
            xhr.send();
            if (xhr.status === 0 || xhr.status === 200) return xhr.responseText;
        } catch (e) {}
        return "";
    }

    function yafcPut(text) {
        try {
            var xhr = new XMLHttpRequest();
            xhr.open("PUT", yafcViewUrl, false);
            xhr.send(text);
            return (xhr.status === 0 || xhr.status === 200 || xhr.status === 204) &&
                    yafcRead(yafcViewUrl) === text;
        } catch (e) { return false; }
    }

    // keep: renew the layout already on screen even if Ford's report no longer
    // matches. Ford's zoom changes the reported stream, and without renewal the
    // native's 500 ms lease expires and the Hero geometry comes back.
    function yafcPublishView(v, keep) {
        var e = yafcViews[v];
        if (!yafcSession || e === undefined || (keep !== true && e.ford !== yafcFordView) ||
                showFrontCamera !== (v.indexOf("front") === 0) || yafcSeq >= 999999999) return false;
        var hero = yafcViews.rear360;
        // compose=1 only for views the library should reshape. The native
        // acknowledges a compose=0 record without changing the window.
        var compose = (e.compose === true || e.cfg === "rear360" || e.cfg === "front360") ? "1" : "0";
        // Another popup instance may share the mailbox; the native ignores a
        // sequence number below the newest it has seen, so catch up first.
        var cur = yafcRead(yafcViewUrl);
        if (cur.indexOf(yafcSession) === 0) {
            var m = /^([0-9]{1,9});/.exec(cur.substring(yafcSession.length));
            if (m) yafcSeq = Math.max(yafcSeq, Number(m[1]));
        }
        var text = yafcSession + (++yafcSeq) + ";" + compose + ";" +
                [e.camSrc || hero.camSrc, e.camDst || hero.camDst,
                 e.baySrc || hero.baySrc, e.bayDst || hero.bayDst].join(",") + "\n";
        if (!yafcPut(text)) return false;
        yafcRequestedKey = v;
        return true;
    }

    property string yafcPendingView: ""
    property bool yafcCover: false
    property bool yafcZoomSwitch: false
    property int yafcZoomExtraMs: 300
    property int yafcCoverMs: 700
    readonly property int yafcFordView: AL2HMIBridge.rvcSource.multicameraShowing
    // The Ford report is the completion signal for a view switch: commit the
    // pending key here instead of waiting for the next 100 ms poll tick.
    onYafcFordViewChanged: yafcCommitPendingView()

    function yafcApplyLayout(v) {
        var e = yafcViews[v];
        if (e === undefined) return false;
        // The look (divider, sensors, Zoom position) follows Ford's report at
        // once, as in the proven build. The mailbox write is best effort: the
        // poll republishes yafcViewKey until it lands.
        yafcViewKey = v;
        yafcView = e.cfg;
        yafcSensors = e.sensors === true;
        yafcLook(e);
        yafcZoom = e.zoom === true;
        yafcZoomTries = 0;
        yafcShown = true;
        if (yafcSession) yafcPublishView(v);
        yafcSyncZoom();
        return true;
    }

    // Make Ford's zoom level match the layout: zoomed only for Trailer.
    function yafcSyncZoom() {
        if (!yafcShown) return;
        if (yafcZoomTimer.running) return;
        var maxed = AL2HMIBridge.rvcSource.rvcZoomLevel === AL2HMIBridge.RVCSource.ZoomLevelMax;
        if (yafcZoom === maxed) return;
        if (yafcZoomTries >= 3) return;
        yafcZoomTries++;
        if (yafcZoom) _hmirvcController.zoomIn(); else _hmirvcController.zoomOut();
        yafcZoomTimer.restart();
    }
    property int yafcZoomTries: 0
    Timer { id: yafcZoomTimer; interval: 1200; onTriggered: yafcSyncZoom() }
    readonly property var yafcZoomLevel: AL2HMIBridge.rvcSource.rvcZoomLevel
    onYafcZoomLevelChanged: {
        yafcZoomTimer.stop();
        if (yafcShown) yafcSyncZoom();
    }

    function yafcCoverDwell() {
        yafcCoverTimer.interval = yafcCoverMs + (yafcZoomSwitch ? yafcZoomExtraMs : 0);
        yafcZoomSwitch = false;
        yafcCoverTimer.restart();
    }

    function yafcRelease() {
        // The native accepts only <session><seq>;<compose>;<16 rects>\n. The
        // old ";off" sentinel failed that parser and was ignored, so it never
        // restored the factory window. compose=0 is the record that makes the
        // native leave composition; the rectangles are validated, not applied.
        if (!yafcSession || yafcSeq >= 999999999) return;
        var hero = yafcViews.rear360;
        yafcPut(yafcSession + (++yafcSeq) + ";0;" +
                [hero.camSrc, hero.camDst, hero.baySrc, hero.bayDst].join(",") + "\n");
    }

    function yafcStock() {
        yafcZoomTimer.stop();
        yafcRelease();
        yafcRequestedKey = "";
    }

    // Completes a view picked with yafcSelectView once Ford reports it. The key
    // stays pending on a failed publish so the timeout can retry.
    function yafcCommitPendingView() {
        var v = yafcPendingView;
        // A hide clears the pending key, so no extra visibility gate is needed
        // here; the root `visible` property is not reliable on this unit.
        if (v === "" || yafcViews[v] === undefined) return;
        if (yafcViews[v].ford !== yafcFordView ||
                showFrontCamera !== (v.indexOf("front") === 0)) return;
        if (!yafcApplyLayout(v)) return;
        yafcPendingView = "";
        yafcViewTimeout.stop();
        if (yafcCover) yafcCoverDwell();
    }

    // Takes the layout for Ford's reported view, or publishes the layout
    // already taken once the session appears. The report decides the key; the
    // session only enables publishing.
    function yafcFollowFord() {
        if (!yafcSession) return;
        if (yafcPendingView !== "") { yafcCommitPendingView(); return; }
        if (yafcRequestedKey !== "" && yafcViews[yafcRequestedKey] !== undefined &&
                yafcViews[yafcRequestedKey].ford === yafcFordView &&
                showFrontCamera === (yafcRequestedKey.indexOf("front") === 0)) return;
        // Keep the layout already on screen when it still matches Ford; at
        // entry go to the configured default first, then any view that matches
        // the report. Several views share a Ford id (rear360/full360), so the
        // raw view key alone would pick the wrong button for the preference.
        var key = "";
        if (yafcShown && yafcViews[yafcViewKey] !== undefined &&
                yafcViews[yafcViewKey].ford === yafcFordView &&
                showFrontCamera === (yafcViewKey.indexOf("front") === 0)) key = yafcViewKey;
        if (key === "") {
            key = yafcDefaultKey(showFrontCamera);
            if (yafcViews[key].ford !== yafcFordView) {
                var keys = showFrontCamera ? ["front360", "front", "frontwide"] : ["rear360", "rear", "wide"];
                for (var i = 0; i < keys.length; i++)
                    if (yafcViews[keys[i]].ford === yafcFordView) { key = keys[i]; break; }
            }
        }
        if (yafcViews[key].ford !== yafcFordView) return;
        yafcApplyLayout(key);
    }

    function yafcPoll() {
        // A latched hide keeps the release in force; only an explicit show or
        // a tap resumes. Otherwise the native writes the session file on its
        // first post, which happens after this popup opens. Force the entry
        // route here too: on this unit the root `visible` property did not
        // always track the popup being up.
        if (yafcHidden) return;
        if (!yafcSession) { yafcVisibleChanged(true); return; }
        if (!yafcLoadConfig() || yafcRead(yafcSessionUrl) !== yafcSession) { yafcStop(); return; }
        if (!yafcShown || yafcRequestedKey === "") { yafcFollowFord(); return; }
        // Ford changed the stream under the published layout. Re-take a layout
        // that matches its report instead of letting the 500 ms lease expire;
        // a pending pick owns the change and waits for its own report.
        if (yafcViews[yafcViewKey] === undefined) return;
        if (!yafcZoom && yafcViews[yafcViewKey].ford !== yafcFordView) {
            if (yafcPendingView === "") yafcFollowFord();
            return;
        }
        // Renew the lease. Never touch the cover or the default timer here;
        // both start from the report, and a 100 ms renewal would postpone them.
        yafcPublishView(yafcViewKey, yafcZoom);
    }

    function yafcReconcile() {
        // No report arrived for the pending view. Retry the selected key when
        // Ford now reports its stream, then fall back to whatever Ford reports;
        // a camera screen must not stay black.
        var pending = yafcPendingView;
        yafcPendingView = "";
        var k = "";
        if (pending !== "" && yafcViews[pending] !== undefined &&
            yafcViews[pending].ford === yafcFordView &&
            showFrontCamera === (pending.indexOf("front") === 0)) k = pending;
        if (k === "" && yafcViews[yafcViewKey] !== undefined &&
            yafcViews[yafcViewKey].ford === yafcFordView &&
            showFrontCamera === (yafcViewKey.indexOf("front") === 0)) k = yafcViewKey;
        if (k === "") {
            // Rear and Trailer share the IPMBRearNormal report; prefer the plain
            // view so a failed Rear Only tap does not silently become Zoomed View.
            var pref = showFrontCamera ? "front" : "rear";
            if (yafcViews[pref].ford === yafcFordView) k = pref;
            else for (var n in yafcViews)
                if (yafcViews[n].ford === yafcFordView) { k = n; break; }
        }
        if (k !== "" && yafcApplyLayout(k) && yafcCover) yafcCoverDwell();
        else yafcCover = false;
    }

    function yafcSelectView(v) {
        // A tap proves the popup is up; if a hide latched the poll, resume it.
        yafcHidden = false;
        var e = yafcViews[v];
        // Taps are serialized while a switch settles. No yafcShown gate: a tap
        // must still work when the first layout has not been taken yet.
        if (e === undefined || yafcCover) return;
        if (!yafcLoadConfig()) { yafcStop(); return; }
        if (yafcSession && yafcRead(yafcSessionUrl) !== yafcSession) { yafcStop(); return; }
        yafcUserPicked = true;
        yafcDefaultTimer.stop();
        // Only leaving Zoomed View settles slowly.
        yafcZoomSwitch = yafcZoom && e.zoom !== true;
        yafcPendingView = v;
        // Choosing a view closes the row.
        yafcPanelOpen = false;
        if (yafcFordView === e.ford) {
            // Same stream, possibly only Ford's zoom level changes: cover the
            // re-zoom, then apply at once because no report will follow.
            if (yafcCoverMs > 0 && (e.zoom === true || yafcZoom)) { yafcCover = true; yafcViewTimeout.restart(); }
            yafcCommitPendingView();
        } else {
            if (yafcCoverMs > 0) yafcCover = true;
            yafcViewTimeout.restart();
            _hmirvcController.selectRVCView(e.ford);
        }
    }

    // Only Settings persists preferences. Reset the RAM selection on close and
    // again on entry for the camera Ford actually opened.
    property bool yafcUserPicked: false
    property bool yafcShown: false
    // Set only by an explicit hide after the popup was active. The poll cannot
    // be gated on `visible` (it did not track the popup on this unit), so this
    // latch is what keeps a hidden but still-loaded popup from re-adopting the
    // session and undoing the compose=0 release. An explicit show or a tap
    // clears it.
    property bool yafcHidden: false
    function yafcDefaultKey(front) {
        var map = front ? { "front360": "front360", "front": "front", "360": "front360only", "frontwide": "frontwide" }
                        : { "rear360": "rear360", "rear": "rear", "360": "full360", "rearwide": "wide" };
        var pref = front ? yafcFrontViewPref : yafcRearViewPref;
        return map[pref] !== undefined ? map[pref] : (front ? "front360" : "rear360");
    }
    function yafcApplyDefault() {
        var key = yafcDefaultKey(showFrontCamera);
        if (yafcUserPicked || yafcViews[key] === undefined) return;
        // Re-apply when Ford still shows another stream, even if the local key
        // already matches: without a session the local layout cannot compose.
        if (yafcShown && key === yafcViewKey && yafcViews[key].ford === yafcFordView) return;
        yafcSelectView(key);
    }

    function yafcStop() {
        yafcStock();
        yafcDefaultTimer.stop();
        yafcViewTimeout.stop();
        yafcCoverTimer.stop();
        yafcPendingView = "";
        yafcCover = false;
        yafcZoomSwitch = false;
        yafcPanelOpen = false;
        yafcUserPicked = false;
        yafcShown = false;
        yafcSession = "";
    }

    function yafcVisibleChanged(vis) {
        if (!vis) {
            // Hide: release the lease, close the panel, clear the transient
            // selection. Latch only when the popup was active; at
            // Component.onCompleted(false) on a unit where `visible` is
            // unreliable, the poll must still be able to take the first layout.
            if (yafcShown || yafcSession !== "") yafcHidden = true;
            yafcStop();
            return;
        }
        yafcHidden = false;
        if (!yafcLoadConfig()) return;
        var session = yafcRead(yafcSessionUrl);
        if (/^[1-9][0-9]*\.[0-9]+\.[0-9]+;$/.test(session) && session !== yafcSession) {
            var records = [yafcRead(yafcViewUrl), yafcRead(yafcReadyUrl)];
            for (var i = 0; i < records.length; i++) {
                if (records[i].indexOf(session) !== 0) continue;
                var seq = /^([0-9]{1,9});/.exec(records[i].substring(session.length));
                if (seq) yafcSeq = Math.max(yafcSeq, Number(seq[1]));
            }
            yafcSession = session;
            yafcUserPicked = false;
        }
        // camera.conf is enough to take the layout: the native composes from it.
        // The session only enables live view changes through the mailbox.
        if (!yafcShown) {
            if (yafcSession) yafcFollowFord();
            else if (yafcPendingView === "") {
                yafcApplyLayout(yafcDefaultKey(showFrontCamera));
                yafcViewTimeout.stop();
                yafcCover = false;
            }
            // Wait for Ford to settle on its opening view before moving to the
            // preference, unless the user picks first.
            if (!yafcUserPicked) yafcDefaultTimer.restart();
        } else if (yafcRequestedKey === "") {
            // The layout was taken without a session. Publish it now.
            yafcFollowFord();
        }
    }

    // Always on: the popup only exists while Ford has it up, and yafcPoll decides
    // from camera.conf and the session file. Gating this on `visible` meant the
    // layout was never taken when that property did not track the popup being up.
    Timer { interval: 100; repeat: true; running: true; onTriggered: yafcPoll() }

    Component.onCompleted: yafcVisibleChanged(visible)

    // Keep the stock bindings intact when the popup is not in YAFC mode.
    Binding { target: zoomButton; property: "visible"; value: false; when: yafcHideChrome }
    Binding { target: cameraViewButtons; property: "visible"; value: false; when: yafcHideChrome }
    Binding { target: pdcImage; property: "visible"; value: false; when: yafcHideChrome }
    Binding { target: bottomContainer; property: "source"; value: ""; when: yafcHideChrome }
    Binding {
        target: container
        property: "height"
        value: _rVCPopupStyle.yafcPopupComponentHeight
        when: yafcHideChrome
    }
    Binding {
        target: bottomContainer
        property: "height"
        value: UiTheme.styleRoot.navigationBarHeight + UiTheme.styleRoot.generalMarginBig * 2
        when: yafcHideChrome
    }
    Binding { target: cancelButton; property: "visible"; value: yafcCancelShown; when: yafcHideChrome }
    Binding { target: textLabel; property: "visible"; value: showZoomButton && !yafcHideChrome; when: yafcHideChrome }

    onShowFrontCameraChanged: if (visible) { yafcStop(); yafcVisibleChanged(true); }

    readonly property bool yafcCancelShown: (showCancelButton && !ViewController.qrvc && cameraViewActivatedByReverseGear) || showCancelButtonBoundaryAlertRVC