# yafc-fragment v1
# id: popup-1-state
# target: hmirvc/+10inchP/RVCPopup.qml
# edit: append-after
# anchor: property int aPAPopupWidth: UiTheme.styleRoot.applicationWidth
# end-header

    // YAFC state. The popup publishes the live selection to a RAM mailbox;
    // only the Settings page persists preferences.
    property bool yafcPanelOpen: false
    property bool yafcHideChromePref: true
    readonly property bool yafcHideChrome: yafcShown && yafcHideChromePref
    property string yafcView: "rear"
    // Which view button is lit. Not always the config value: the library
    // composes only the combined views, so Trailer and Wide keep the config
    // value while Ford shows another view id.
    property string yafcViewKey: "rear360"
    property bool yafcSensors: true
    property bool yafcZoom: false
    // Screen is 800x1280. Per view: `holes` are the rectangles where live
    // video shows through the transparent popup; `sen` is the sensor panel and
    // `senScale` its car size; `fill` is the black backdrop that covers
    // everything else, so no other app can show through a gap.
    readonly property var yafcViews: ({
        "rear360": { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "0,84,439,316", camDst: "0,0,800,518",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     holes: [[0,0,800,518],[0,522,456,718]],
                     sen: [456,522,344,718], senScale: 1.8,
                     fill: [[0,518,800,4],[0,1240,800,40]],
                     sensors: true,  zoom: false },
        // Trailer: Ford's zoom applied to the plain rear stream, laid out like
        // Rear Only. Zoom on the Hero stream gives the skewed picture.
        "zoom":    { ford: AL2HMIBridge.RVCSource.IPMBRearNormal, cfg: "rear",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: true },
        "rear":    { ford: AL2HMIBridge.RVCSource.IPMBRearNormal, cfg: "rear",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "full360": { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "447,0,273,480", camDst: "0,0,800,1240",
                     baySrc: "447,0,273,480", bayDst: "0,0,0,0",
                     holes: [[0,0,800,1240]],
                     sen: [0,0,0,0], senScale: 1,
                     fill: [[0,1240,800,40]],
                     sensors: false, zoom: false },
        "wide":    { ford: AL2HMIBridge.RVCSource.IPMBRearSplit, cfg: "rear",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "front":   { ford: AL2HMIBridge.RVCSource.IPMBFrontNormal, cfg: "front",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "frontwide": { ford: AL2HMIBridge.RVCSource.IPMBFrontSplit, cfg: "front",
                     camSrc: "0,6,720,474", camDst: "0,400,800,480",
                     bayDst: "0,0,0,0", compose: true,
                     holes: [[0,400,800,480]],
                     sen: [0,880,800,360], senScale: 1.2,
                     fill: [[0,0,800,400],[0,1240,800,40]],
                     sensors: true, zoom: false },
        "front360only": { ford: AL2HMIBridge.RVCSource.IPMBFront360, cfg: "front360",
                     camSrc: "447,0,273,480", camDst: "0,0,800,1240",
                     baySrc: "447,0,273,480", bayDst: "0,0,0,0",
                     holes: [[0,0,800,1240]],
                     sen: [0,0,0,0], senScale: 1,
                     fill: [[0,1240,800,40]],
                     sensors: false, zoom: false },
        "front360": { ford: AL2HMIBridge.RVCSource.IPMBFront360, cfg: "front360",
                     camSrc: "0,84,439,316", camDst: "0,0,800,518",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     holes: [[0,0,800,518],[0,522,456,718]],
                     sen: [456,522,344,718], senScale: 1.8,
                     fill: [[0,518,800,4],[0,1240,800,40]],
                     sensors: true,  zoom: false }
    })

    // The look of the current view; set by yafcLook(). Defaults are the Hero.
    property var yafcSen: [456,522,344,718]
    property real yafcSenScale: 1.8
    property var yafcFill: [[0,518,800,4],[0,1240,800,40]]
    function yafcLook(e) {
        if (e === undefined || e.sen === undefined) return;
        yafcSen = e.sen;
        yafcSenScale = e.senScale;
        yafcFill = e.fill;
    }

    // Per-camera default view, chosen on the Camera Settings page. Stored in
    // camera.conf (`rear_view`, `front_view`) and applied whenever the popup
    // opens or closes.
    property string yafcFrontViewPref: "front360"
    property string yafcRearViewPref: "rear360"
    property string yafcConfigPath: "file:///fs/rwdata/yafc/camera.conf"
    property string yafcDisablePath: "file:///fs/rwdata/yafc/DISABLE"

    function yafcDisabled() {
        var xhr = new XMLHttpRequest();
        try {
            xhr.open("GET", yafcDisablePath, false);
            xhr.send();
            // A local reply can have status 0 even on success. The length
            // header also detects an empty marker made with touch.
            return xhr.status === 200 ||
                    (xhr.status === 0 && (/^[0-9]+$/.test(xhr.getResponseHeader("Content-Length")) ||
                                         xhr.responseText.length > 0));
        } catch (e) {
            return true;
        }
    }

    function yafcLoadConfig() {
        yafcHideChromePref = true;
        yafcFrontViewPref = "front360";
        yafcRearViewPref = "rear360";
        yafcCoverMs = 700;
        if (yafcDisabled()) return false;
        var mode = "pass";
        var enabled = true;
        var sawEnabled = false;
        var xhr = new XMLHttpRequest();
        try {
            xhr.open("GET", yafcConfigPath, false);
            xhr.send();
            if (xhr.status === 0 || xhr.status === 200) {
                var lines = xhr.responseText.split("\n");
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i].trim();
                    if (line.length === 0 || line.charAt(0) === "#") continue;
                    var eq = line.indexOf("=");
                    if (eq < 0) continue;
                    var key = line.substring(0, eq).trim();
                    var val = line.substring(eq + 1).trim();
                    if (key === "front_view") yafcFrontViewPref = val;
                    if (key === "rear_view") yafcRearViewPref = val;
                    if (key === "mode") mode = val;
                    if (line.indexOf("enabled=") === 0 && !sawEnabled) {
                        enabled = line.charAt(8) !== "0";
                        sawEnabled = true;
                    }
                    if (key === "hide_chrome") yafcHideChromePref = (val === "1");
                    if (key === "cover_ms") yafcCoverMs = Math.max(0, Math.min(3000, parseInt(val, 10) || 0));
                }
            }
        } catch (e) {
            console.log("yafc: config read failed: " + e);
        }
        return enabled && mode === "compose";
    }

    // Session identity: PID.monotonic_sec.monotonic_nsec;
    // The native writes /fs/tmpfs/yafc-session at start. The popup reads it
    // on entry and prefixes every mailbox record with it. A mismatch means the
    // native restarted or is absent; the popup then stops asserting a custom
    // layout. There is no atomic cross-process liveness proof: a ready reply
    // means the native processed the request and the compositor accepted the
    // property sets, not that the display painted the result. QML timers stall
    // with the render thread; a late-created bay may never paint.
    property string yafcSession: ""
    property string yafcRequest: ""
    property string yafcLastAck: ""
    property string yafcRequestedKey: ""
    property int yafcSeq: 0
    property double yafcSentAt: 0
    property string yafcViewUrl: "file:///fs/tmpfs/yafc-view"
    property string yafcReadyUrl: "file:///fs/tmpfs/yafc-ready"
    property string yafcSessionUrl: "file:///fs/tmpfs/yafc-session"

    function yafcRead(url) {
        try {
            var xhr = new XMLHttpRequest();
            xhr.open("GET", url, false);
            xhr.send();
            if (xhr.status === 0 || xhr.status === 200) return xhr.responseText;
        } catch (e) {}
        return "";
    }

    function yafcPut(text) {
        try {
            var xhr = new XMLHttpRequest();
            xhr.open("PUT", yafcViewUrl, false);
            xhr.send(text);
            return (xhr.status === 0 || xhr.status === 200 || xhr.status === 204) &&
                    yafcRead(yafcViewUrl) === text;
        } catch (e) { return false; }
    }

    function yafcPublishView(v) {
        var e = yafcViews[v];
        if (!yafcSession || e === undefined || e.ford !== yafcFordView ||
                showFrontCamera !== (v.indexOf("front") === 0) || yafcSeq >= 999999999) return false;
        var hero = yafcViews.rear360;
        // compose=1 only for views the native should reshape. 360-only views
        // use the stock geometry and set compose=0 so the native acknowledges
        // without changing the window. The native never composes for a view
        // whose published compose flag is 0.
        var compose = (e.compose === true || e.cfg === "rear360" || e.cfg === "front360") ? "1" : "0";
        var text = yafcSession + (++yafcSeq) + ";" + compose + ";" +
                [e.camSrc || hero.camSrc, e.camDst || hero.camDst,
                 e.baySrc || hero.baySrc, e.bayDst || hero.bayDst].join(",") + "\n";
        if (!yafcPut(text)) return false;
        yafcRequest = text;
        yafcRequestedKey = v;
        yafcSentAt = Date.now();
        return true;
    }

    property string yafcPendingView: ""
    property bool yafcCover: false
    property bool yafcZoomSwitch: false
    property int yafcZoomExtraMs: 300
    property int yafcCoverMs: 700
    readonly property int yafcFordView: AL2HMIBridge.rvcSource.multicameraShowing
    onYafcFordViewChanged: yafcFollowFord()

    function yafcApplyLayout(v) {
        var e = yafcViews[v];
        yafcViewKey = v;
        yafcView = e.cfg;
        yafcSensors = e.sensors === true;
        yafcLook(e);
        yafcZoom = e.zoom === true;
        yafcZoomTries = 0;
        yafcShown = true;
        yafcSyncZoom();
        return true;
    }

    // Make Ford's zoom level match the layout: zoomed only for Trailer.
    function yafcSyncZoom() {
        if (!yafcShown) return;
        if (yafcZoomTimer.running) return;
        var maxed = AL2HMIBridge.rvcSource.rvcZoomLevel === AL2HMIBridge.RVCSource.ZoomLevelMax;
        if (yafcZoom === maxed) return;
        if (yafcZoomTries >= 3) return;
        yafcZoomTries++;
        if (yafcZoom) _hmirvcController.zoomIn(); else _hmirvcController.zoomOut();
        yafcZoomTimer.restart();
    }
    property int yafcZoomTries: 0
    Timer { id: yafcZoomTimer; interval: 1200; onTriggered: yafcSyncZoom() }
    readonly property var yafcZoomLevel: AL2HMIBridge.rvcSource.rvcZoomLevel
    onYafcZoomLevelChanged: {
        yafcZoomTimer.stop();
        if (yafcShown) yafcSyncZoom();
    }

    function yafcCoverDwell() {
        yafcCoverTimer.interval = yafcCoverMs + (yafcZoomSwitch ? yafcZoomExtraMs : 0);
        yafcZoomSwitch = false;
        yafcCoverTimer.restart();
    }

    function yafcStock() {
        yafcShown = false;
        yafcPanelOpen = false;
        yafcZoomTimer.stop();
        yafcCoverTimer.stop();
        if (yafcRequest && yafcRead(yafcViewUrl) === yafcRequest)
            yafcPut(yafcSession + yafcSeq + ";off\n");
        yafcRequest = "";
        yafcLastAck = "";
        yafcRequestedKey = "";
    }

    function yafcFollowFord() {
        if (!yafcSession) return;
        if (yafcRequestedKey && yafcViews[yafcRequestedKey].ford === yafcFordView &&
                showFrontCamera === (yafcRequestedKey.indexOf("front") === 0)) return;
        yafcStock();
        var key = yafcPendingView || yafcDefaultKey(showFrontCamera);
        if (yafcViews[key].ford !== yafcFordView && !yafcPendingView) {
            var keys = showFrontCamera ? ["front360", "front", "frontwide"] : ["rear360", "rear", "wide"];
            for (var i = 0; i < keys.length; i++)
                if (yafcViews[keys[i]].ford === yafcFordView) key = keys[i];
        }
        if (yafcViews[key].ford === yafcFordView && !yafcPublishView(key)) yafcStop();
    }

    function yafcPoll() {
        if (!yafcSession) return;
        if (!yafcLoadConfig() || yafcRead(yafcSessionUrl) !== yafcSession) { yafcStop(); return; }
        if (!yafcRequest) return;
        var elapsed = Date.now() - yafcSentAt;
        if (elapsed < 0 || elapsed >= 400) { yafcStop(); return; }
        var key = yafcRequestedKey;
        if (yafcViews[key].ford !== yafcFordView) { yafcFollowFord(); return; }
        var reply = yafcRead(yafcReadyUrl);
        if (reply !== yafcRequest) {
            if (yafcShown && reply !== yafcLastAck) yafcStop();
            return;
        }
        // Two advancing replies are required on entry. A leftover file (even
        // for this PID) cannot both answer and renew a request.
        var confirmed = yafcLastAck !== "";
        yafcLastAck = reply;
        if (!yafcPublishView(key)) { yafcStop(); return; }
        if (confirmed && !yafcShown) {
            yafcApplyLayout(key);
            yafcPendingView = "";
            yafcViewTimeout.stop();
            if (yafcCover) yafcCoverDwell();
            if (!yafcUserPicked) yafcDefaultTimer.restart();
        }
    }

    function yafcReconcile() {
        // No matching Ford report or composition reply: return control to Ford.
        yafcStop();
    }

    function yafcSelectView(v) {
        var e = yafcViews[v];
        if (!yafcShown || e === undefined || yafcCover) return;
        var reply = yafcRead(yafcReadyUrl), elapsed = Date.now() - yafcSentAt;
        if (!yafcLoadConfig() || yafcRead(yafcSessionUrl) !== yafcSession ||
                elapsed < 0 || elapsed >= 400 || (reply !== yafcLastAck && reply !== yafcRequest)) {
            yafcStop();
            return;
        }
        yafcUserPicked = true;
        yafcDefaultTimer.stop();
        yafcZoomSwitch = yafcZoom && e.zoom !== true;
        yafcPendingView = v;
        yafcStock();
        yafcCover = yafcCoverMs > 0 && (e.ford !== yafcFordView || e.zoom === true || yafcZoom);
        yafcViewTimeout.restart();
        if (yafcFordView === e.ford) yafcFollowFord();
        else _hmirvcController.selectRVCView(e.ford);
    }

    // Only Settings persists preferences. Reset the RAM selection on close and
    // again on entry for the camera Ford actually opened.
    property bool yafcUserPicked: false
    property bool yafcShown: false
    function yafcDefaultKey(front) {
        var map = front ? { "front360": "front360", "front": "front", "360": "front360only", "frontwide": "frontwide" }
                        : { "rear360": "rear360", "rear": "rear", "360": "full360", "rearwide": "wide" };
        var pref = front ? yafcFrontViewPref : yafcRearViewPref;
        return map[pref] !== undefined ? map[pref] : (front ? "front360" : "rear360");
    }
    function yafcApplyDefault() {
        var key = yafcDefaultKey(showFrontCamera);
        if (yafcShown && !yafcUserPicked && key !== yafcViewKey) yafcSelectView(key);
    }

    function yafcStop() {
        if (!yafcSession) return;
        yafcStock();
        yafcDefaultTimer.stop();
        yafcViewTimeout.stop();
        yafcPendingView = "";
        yafcCover = false;
        yafcZoomSwitch = false;
        yafcSession = "";
    }

    function yafcVisibleChanged(vis) {
        if (!vis) { yafcStop(); return; }
        if (yafcSession || !yafcLoadConfig()) return;
        var session = yafcRead(yafcSessionUrl);
        if (!/^[1-9][0-9]*\.[0-9]+\.[0-9]+;$/.test(session)) return;
        var records = [yafcRead(yafcViewUrl), yafcRead(yafcReadyUrl)];
        for (var i = 0; i < records.length; i++) {
            if (records[i].indexOf(session) !== 0) continue;
            var seq = /^([0-9]{1,9});/.exec(records[i].substring(session.length));
            if (seq) yafcSeq = Math.max(yafcSeq, Number(seq[1]));
        }
        yafcSession = session;
        yafcUserPicked = false;
        yafcFollowFord();
    }

    Timer { interval: 100; repeat: true; running: yafcSession !== ""; onTriggered: yafcPoll() }

    Component.onCompleted: yafcVisibleChanged(visible)

    // Keep the stock bindings intact when the popup is not in YAFC mode.
    Binding { target: zoomButton; property: "visible"; value: false; when: yafcShown }
    Binding { target: cameraViewButtons; property: "visible"; value: false; when: yafcShown }
    Binding { target: pdcImage; property: "visible"; value: false; when: yafcShown }
    Binding { target: bottomContainer; property: "source"; value: ""; when: yafcShown }
    Binding {
        target: container
        property: "height"
        value: _rVCPopupStyle.yafcPopupComponentHeight
        when: yafcShown
    }
    Binding {
        target: bottomContainer
        property: "height"
        value: UiTheme.styleRoot.navigationBarHeight + UiTheme.styleRoot.generalMarginBig * 2
        when: yafcShown
    }
    Binding { target: cancelButton; property: "visible"; value: yafcCancelShown; when: yafcShown }
    Binding { target: textLabel; property: "visible"; value: showZoomButton && !yafcHideChrome; when: yafcShown }

    onShowFrontCameraChanged: if (yafcSession) { yafcStop(); yafcVisibleChanged(visible); }

    readonly property bool yafcCancelShown: (showCancelButton && !ViewController.qrvc && cameraViewActivatedByReverseGear) || showCancelButtonBoundaryAlertRVC