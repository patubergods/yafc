# yafc-fragment v1
# id: panel-1-state
# target: hmirvc/+10inchP/RVCPopup.qml
# edit: append-after
# anchor: property int aPAPopupWidth: UiTheme.styleRoot.applicationWidth
# end-header

    // yafc state. The popup and the Settings page write one file, so each
    // save keeps every key it does not own.
    property bool yafcPanelOpen: false
    property bool yafcHideChrome: false
    property bool yafcEnabled: false
    property string yafcView: "rear"
    // Which view button is lit. Not always the config value: the library
    // composes only the combined views, so trailer zoom and wide keep
    // view=rear360 / rear while Ford shows another view id.
    property string yafcViewKey: "rear360"
    // Our own geometry. Each view button writes its rectangles to the config
    // and the library reads them live; x,y,w,h in the source buffer (src) and
    // on screen (dst).
    property string yafcCamSrc: "0,84,439,316"
    property string yafcCamDst: "0,0,800,518"
    property string yafcBaySrc: "447,0,273,480"
    property string yafcBayDst: "0,522,456,718"
    property bool yafcSensors: true
    property bool yafcZoom: false
    // One entry per view button. `ford` is the view asked of the HMI, `cfg`
    // what the library composes, `sensors` whether our sensor panel shows.
    readonly property var yafcViews: ({
        "rear360": { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "0,84,439,316", camDst: "0,0,800,518",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     sensors: true,  zoom: false },
        "zoom":    { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "0,84,439,316", camDst: "0,0,800,518",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     sensors: true,  zoom: true },
        "rear":    { ford: AL2HMIBridge.RVCSource.IPMBRearNormal, cfg: "rear",
                     sensors: false, zoom: false },
        "full360": { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear360",
                     camSrc: "447,0,273,480", camDst: "0,0,800,1240",
                     baySrc: "447,0,273,480", bayDst: "0,0,0,0",
                     sensors: false, zoom: false },
        "wide":    { ford: AL2HMIBridge.RVCSource.IPMBRear360, cfg: "rear",
                     baySrc: "447,0,273,480", bayDst: "0,522,456,718",
                     sensors: true,  zoom: false }
    })
    property string yafcMode: "pass"
    property string yafcLayout: "stock"
    property string yafcBay: "450"
    property string yafcBaySide: "left"
    property string yafcBackground: "black"
    property string yafcConfigPath: "file:///fs/rwdata/yafc/camera.conf"

    function yafcLoadConfig() {
        yafcHideChrome = false;
        var xhr = new XMLHttpRequest();
        xhr.open("GET", yafcConfigPath, false);
        try {
            xhr.send();
            if (xhr.status === 0 || xhr.status === 200) {
                var lines = xhr.responseText.split("\n");
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i].trim();
                    if (line.length === 0 || line.charAt(0) === "#") continue;
                    var eq = line.indexOf("=");
                    if (eq < 0) continue;
                    var key = line.substring(0, eq).trim();
                    var val = line.substring(eq + 1).trim();
                    if (key === "layout") yafcLayout = val;
                    if (key === "view") { yafcView = val; yafcViewKey = val; }
                    if (key === "cam_src") yafcCamSrc = val;
                    if (key === "cam_dst") yafcCamDst = val;
                    if (key === "bay_src") yafcBaySrc = val;
                    if (key === "bay_dst") yafcBayDst = val;
                    if (key === "hide_chrome") yafcHideChrome = (val === "1");
                    if (key === "enabled") yafcEnabled = (val === "1");
                    if (key === "bay_360") yafcBay = val;
                    if (key === "bay_side") yafcBaySide = val;
                    if (key === "mode") yafcMode = val;
                    if (key === "background") yafcBackground = val;
                }
            }
        } catch (e) {
            console.log("yafc: config read failed: " + e);
        }
    }

    function yafcSaveConfig() {
        var order = [];
        var owned = {};
        function own(k, v) {
            if (order.indexOf(k) < 0) order.push(k);
            owned[k] = "" + v;
        }
        own("version", 1);
        own("enabled", yafcEnabled ? "1" : "0");
        own("layout", yafcLayout);
        own("view", yafcView);
        own("bay_360", yafcBay);
        own("bay_side", yafcBaySide);
        own("background", yafcBackground);
        own("mode", yafcMode);
        // The view geometry is ours: the library reads these keys live.
        own("cam_src", yafcCamSrc);
        own("cam_dst", yafcCamDst);
        own("bay_src", yafcBaySrc);
        own("bay_dst", yafcBayDst);
        // reread=1 lets the library look at the file on every post; its own
        // wall-clock gate keeps that to a few reads a second.
        own("reread", 1);

        // Keep every other line byte for byte. Re-serialising a line the
        // native reader parses by its first byte could change its meaning.
        var keep = [];
        var get = new XMLHttpRequest();
        get.open("GET", yafcConfigPath, false);
        try {
            get.send();
            if (get.status === 0 || get.status === 200) {
                var lines = get.responseText.split("\n");
                for (var i = 0; i < lines.length; i++) {
                    var raw = lines[i];
                    var line = raw.replace(/^\s+|\s+$/g, "");
                    if (line.length === 0) continue;
                    if (line.charAt(0) === "#") { keep.push(raw); continue; }
                    var eq = line.indexOf("=");
                    if (eq < 0) { keep.push(raw); continue; }
                    var k = line.substring(0, eq).replace(/^\s+|\s+$/g, "");
                    if (Object.prototype.hasOwnProperty.call(owned, k)) continue;
                    keep.push(raw);
                }
            }
        } catch (e) {
            // Unreadable file: refuse to overwrite settings we never saw.
            console.log("yafc: config unreadable, not saving: " + e);
            return;
        }
        // Our keys go first: the native reader stops at 1023 bytes.
        var parts = [];
        for (var j = 0; j < order.length; j++) parts.push(order[j] + "=" + owned[order[j]]);
        var text = parts.concat(keep).join("\n") + "\n";
        var xhr = new XMLHttpRequest();
        xhr.open("PUT", yafcConfigPath, false);
        try {
            xhr.send(text);
            console.log("yafc: config saved");
        } catch (e) {
            console.log("yafc: config save failed: " + e);
        }
    }

    // Apply a view: our geometry first, then the Ford view, then persist.
    function yafcSelectView(v) {
        var e = yafcViews[v];
        if (e === undefined) {
            yafcViewKey = v;
            yafcView = v;
            yafcSaveConfig();
            return;
        }
        yafcViewKey = v;
        yafcView = e.cfg;
        yafcSensors = e.sensors === true;
        yafcZoom = e.zoom === true;
        if (e.camSrc !== undefined) yafcCamSrc = e.camSrc;
        if (e.camDst !== undefined) yafcCamDst = e.camDst;
        if (e.baySrc !== undefined) yafcBaySrc = e.baySrc;
        if (e.bayDst !== undefined) yafcBayDst = e.bayDst;
        yafcSaveConfig();
        _hmirvcController.selectRVCView(e.ford);
        if (yafcZoom) _hmirvcController.zoomIn();
    }

    Component.onCompleted: yafcLoadConfig()
